# Apptainer definition generated from pytorch_base/Dockerfile
# Build hint: export SINGULARITY_DOCKER_USERNAME=$oauthtoken and SINGULARITY_DOCKER_PASSWORD=<NGC_API_KEY> before `apptainer build --fakeroot pytorch_base.sif Apptainer.def`

Bootstrap: docker
From: nvcr.io/nvidia/pytorch:24.11-py3
# To align with driver R580+, switch to: From: nvcr.io/nvidia/pytorch:25.09-py3

%labels
    Maintainer bmmorales
    App pytorch_base

%files
    requirements-ngc.txt /opt/requirements-ngc.txt

%post
    set -eux
    if [ -f /etc/pip/constraint.txt ]; then
        C="-c /etc/pip/constraint.txt"
    else
        C=""
    fi
    python -m pip install --upgrade pip
    python -m pip install -r /opt/requirements-ngc.txt ${C}
    # Enable DALI if/when needed:
    # python -m pip install --extra-index-url https://developer.download.nvidia.com/compute/redist nvidia-dali-cuda120
    # gpu_energy.py precisa do modulo pynvml; instala so se faltar (conflict-proof)
    python -c "import pynvml" 2>/dev/null || python -m pip install nvidia-ml-py
    rm -rf /root/.cache/pip
    mkdir -p /workspace
    chmod 777 /workspace

%environment
    export KERAS_BACKEND=torch

%runscript
    exec /bin/bash "$@"
