# Apptainer definition para vit_pure (PyTorch, ARM/Grace-Hopper).
Bootstrap: docker
From: nvcr.io/nvidia/pytorch:24.11-py3

%labels
    Maintainer bmmorales
    App vit_pure

%files
    requirements-ngc.txt /opt/requirements-ngc.txt

%post
    set -eux
    if [ -f /etc/pip/constraint.txt ]; then
        C="-c /etc/pip/constraint.txt"
    else
        C=""
    fi
    python -m pip install --upgrade pip
    python -m pip install -r /opt/requirements-ngc.txt ${C}
    # gpu_energy.py precisa do modulo pynvml; instala so se faltar (conflict-proof)
    python -c "import pynvml" 2>/dev/null || python -m pip install nvidia-ml-py
    rm -rf /root/.cache/pip
    mkdir -p /workspace
    chmod 777 /workspace

%environment
    export KERAS_BACKEND=torch
    export PYTHONPATH=/workspace

%runscript
    exec /bin/bash "$@"
